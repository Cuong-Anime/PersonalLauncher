<Window x:Class="PersonalLauncher.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PersonalLauncher.App.Controls"
        Title="{DynamicResource Settings_Title}"
        Width="860"
        Height="580"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#1C1F26"
        Icon="pack://application:,,,/PersonalLauncher;component/Assets/logo.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="5" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#39404F" BorderThickness="1" Background="#1C1F26">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION RAIL (matching Reference Screenshot 3!) -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceRailBrush}" BorderBrush="#2A2F3A" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="{DynamicResource Settings_Title}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#A7B0C0"
                               Margin="26,0,16,18" />

                    <RadioButton Content="{DynamicResource Settings_NavGeneral}"
                                 GroupName="SettingsNav"
                                 Style="{StaticResource SettingsNavButtonStyle}"
                                 IsChecked="{Binding IsGeneralActive, Mode=OneWay}"
                                 Command="{Binding SelectGeneralCommand}" />

                    <RadioButton Content="{DynamicResource Settings_NavAppearance}"
                                 GroupName="SettingsNav"
                                 Style="{StaticResource SettingsNavButtonStyle}"
                                 IsChecked="{Binding IsAppearanceActive, Mode=OneWay}"
                                 Command="{Binding SelectAppearanceCommand}" />

                    <RadioButton Content="{DynamicResource Settings_NavSecret}"
                                 GroupName="SettingsNav"
                                 Style="{StaticResource SettingsNavButtonStyle}"
                                 IsChecked="{Binding IsSecretActive, Mode=OneWay}"
                                 Command="{Binding SelectSecretCommand}" />

                    <RadioButton Content="{DynamicResource Settings_NavAbout}"
                                 GroupName="SettingsNav"
                                 Style="{StaticResource SettingsNavButtonStyle}"
                                 IsChecked="{Binding IsAboutActive, Mode=OneWay}"
                                 Command="{Binding SelectAboutCommand}" />
                </StackPanel>
            </Border>

            <!-- RIGHT CONTENT AREA -->
            <Grid Grid.Column="1" Background="{StaticResource SurfaceMainBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top-Right Close button -->
                <Button Grid.Row="0" Content="×" FontSize="20" Width="34" Height="34"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,12,0"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource TitleBarButtonStyle}" Click="Close_Click" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,4,32,26">
                    <Grid>
                        <!-- =============================================== -->
                        <!-- PAGE 1: GENERAL (Reference Screenshot 3!)       -->
                        <!-- =============================================== -->
                        <StackPanel Visibility="{Binding IsGeneralActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Settings_NavGeneral}" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,22" />

                            <!-- Language -->
                            <TextBlock Text="{DynamicResource Settings_LanguageGroup}" Foreground="#9AA4B8" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="10" Padding="18,14" Margin="0,0,0,20">
                                <Grid>
                                    <TextBlock Text="{DynamicResource Settings_SelectLanguage}" FontSize="14" Foreground="#F5F7FA" VerticalAlignment="Center" />
                                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                              ItemsSource="{Binding Languages}"
                                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              Width="190"
                                              HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <!-- Startup -->
                            <TextBlock Text="{DynamicResource Settings_StartupGroup}" Foreground="#9AA4B8" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{DynamicResource Settings_StartWithWindows}"
                                                   FontSize="14" Foreground="#F5F7FA" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,0,64,0" />
                                        <CheckBox Style="{StaticResource GoldToggleSwitchStyle}"
                                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Settings_StartupDisabledByWin}"
                                               Foreground="#FFB74D" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding IsStartupDisabledByWindows, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding StartupError}"
                                               Foreground="#FF8A80" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding StartupError, Converter={StaticResource NotNullToVis}}" />
                                </StackPanel>
                            </Border>

                            <!-- Close Behavior -->
                            <TextBlock Text="{DynamicResource Settings_CloseGroup}" Foreground="#9AA4B8" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="10" Padding="18,16">
                                <StackPanel>
                                    <RadioButton GroupName="CloseBehaviorGroup"
                                                 Content="{DynamicResource Settings_CloseToTray}"
                                                 Style="{StaticResource GoldRadioButtonStyle}"
                                                 IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                                 Margin="0,0,0,14" />
                                    <RadioButton GroupName="CloseBehaviorGroup"
                                                 Content="{DynamicResource Settings_CloseExit}"
                                                 Style="{StaticResource GoldRadioButtonStyle}"
                                                 IsChecked="{Binding CloseExitApp, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- =============================================== -->
                        <!-- PAGE 2: APPEARANCE                              -->
                        <!-- =============================================== -->
                        <StackPanel Visibility="{Binding IsAppearanceActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Settings_NavAppearance}" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,22" />

                            <TextBlock Text="{DynamicResource Settings_PersonalLogoGroup}" Foreground="#9AA4B8" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="68" Height="68" CornerRadius="34" ClipToBounds="True" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="2" Background="#161920">
                                        <Image Source="{Binding PersonalLogoPreview}" Stretch="UniformToFill" controls:ClipHelper.IsCircular="True" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource Settings_ChangeLogo}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ChangePersonalLogo_Click" />
                                        <Button Content="{DynamicResource Common_ResetDefault}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetPersonalLogoCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding AppearanceMessage}" Foreground="#FF8A80" FontSize="12.5" Margin="0,0,0,14"
                                       Visibility="{Binding AppearanceMessage, Converter={StaticResource NotNullToVis}}" />

                            <TextBlock Text="{DynamicResource Settings_DefaultAssetsGroup}" Foreground="#9AA4B8" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="10" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,22,0">
                                        <TextBlock Text="{DynamicResource Settings_DefaultIconLabel}" Foreground="#D4DCEB" FontSize="12.5" Margin="0,0,0,8" />
                                        <Border Width="88" Height="88" CornerRadius="14" ClipToBounds="True" BorderBrush="#40485A" BorderThickness="1">
                                            <Image Source="{Binding DefaultIconPreview}" Stretch="UniformToFill" controls:ClipHelper.CornerRadius="13" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Settings_DefaultWallpaperLabel}" Foreground="#D4DCEB" FontSize="12.5" Margin="0,0,0,8" />
                                        <Border Height="140" CornerRadius="10" ClipToBounds="True" BorderBrush="#40485A" BorderThickness="1" Margin="0,0,0,10">
                                            <Image Source="{Binding DefaultWallpaperPreview}" Stretch="UniformToFill" controls:ClipHelper.CornerRadius="9" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Settings_ChangeDefaultWp}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" FontSize="12" Margin="0,0,8,0" Click="ChangeDefaultWallpaper_Click" />
                                            <Button Content="{DynamicResource Common_ResetDefault}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" FontSize="12" Command="{Binding ResetDefaultWallpaperCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- =============================================== -->
                        <!-- PAGE 3: SECRET (Always PIN-gated for Manage!)   -->
                        <!-- =============================================== -->
                        <StackPanel Visibility="{Binding IsSecretActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Settings_NavSecret}" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,18" />

                            <!-- PIN Gate inside Settings -> Secret -->
                            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="12" Padding="28,26"
                                    Visibility="{Binding ShowSecretManageGate, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" MaxWidth="390">
                                    <!-- First-time PIN setup -->
                                    <StackPanel Visibility="{Binding IsPinSetupMode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="🔒" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="{DynamicResource Secret_SetupTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Secret_SetupDesc}" Foreground="#B4BDCE" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,18" />

                                        <TextBlock Text="{DynamicResource Secret_NewPin}" FontSize="12.5" Foreground="#D4DCEB" Margin="0,0,0,6" HorizontalAlignment="Center" />
                                        <controls:PinInputControl AutoSubmit="False" PinValue="{Binding SetupPin, Mode=TwoWay}" Margin="0,0,0,12" />

                                        <TextBlock Text="{DynamicResource Secret_ConfirmPin}" FontSize="12.5" Foreground="#D4DCEB" Margin="0,0,0,6" HorizontalAlignment="Center" />
                                        <controls:PinInputControl AutoSubmit="False" PinValue="{Binding SetupConfirmPin, Mode=TwoWay}" Margin="0,0,0,14" />

                                        <TextBlock Text="{Binding SecretAuthError}" Foreground="#FF8A80" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"
                                                   Visibility="{Binding SecretAuthError, Converter={StaticResource NotNullToVis}}" />

                                        <Button Content="{DynamicResource Secret_CreatePinBtn}" Command="{Binding CreateFirstPinCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Manage PIN verification -->
                                    <StackPanel Visibility="{Binding IsPinUnlockMode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="🔒" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="{DynamicResource Secret_UnlockTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Secret_UnlockManageDesc}" Foreground="#B4BDCE" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,18" />

                                        <controls:PinInputControl x:Name="SettingsSecretPinInput"
                                                                  AutoSubmit="True"
                                                                  IsEnabled="{Binding IsInPinCooldown, Converter={StaticResource InvBoolToVis}}"
                                                                  PinCompleted="SettingsSecretPinInput_PinCompleted"
                                                                  InvalidInputAttempted="SettingsSecretPinInput_InvalidInputAttempted" />

                                        <TextBlock Text="{Binding SecretAuthError}" Foreground="#FF8A80" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"
                                                   Visibility="{Binding SecretAuthError, Converter={StaticResource NotNullToVis}}" />
                                    </StackPanel>

                                    <!-- Corrupted Passcode -->
                                    <StackPanel Visibility="{Binding IsPasscodeCorrupted, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="⚠️" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="{DynamicResource Secret_PasscodeCorrupted}" Foreground="#FF8A80" FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Authenticated Secret Management Console -->
                            <StackPanel Visibility="{Binding IsManageAuthenticated, Converter={StaticResource BoolToVis}}">
                                <!-- 1. Hide / Unhide / Direct Add Games -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Secret_ManageGamesGroup}" Foreground="#9AA4B8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Content="{DynamicResource Secret_AddDirectBtn}" Command="{Binding AddDirectSecretGameCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" FontSize="12.5" HorizontalAlignment="Right" />
                                </Grid>

                                <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Public -> Hide -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Secret_PublicGamesLabel}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,6" />
                                            <ListBox ItemsSource="{Binding PublicGames}" MaxHeight="165" Background="#1A1D25" BorderBrush="#343A47" BorderThickness="1">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="6,4" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#EEF2FA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,90,0" />
                                                            <Button Content="{DynamicResource Secret_HideBtn}"
                                                                    Command="{Binding DataContext.HideGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Padding="8,4" FontSize="11.5" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>

                                        <!-- Secret -> Unhide -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Secret_HiddenGamesLabel}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,6" />
                                            <ListBox ItemsSource="{Binding SecretGames}" MaxHeight="165" Background="#1A1D25" BorderBrush="#343A47" BorderThickness="1">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="6,4" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#FFD800" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                                                            <Button Content="{DynamicResource Secret_UnhideBtn}"
                                                                    Command="{Binding DataContext.UnhideGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Padding="8,4" FontSize="11.5" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 2. Change PIN -->
                                <TextBlock Text="{DynamicResource Secret_ChangePinGroup}" Foreground="#9AA4B8" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{DynamicResource Secret_CurrentPin}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,4" />
                                                <controls:PinInputControl AutoSubmit="False" PinValue="{Binding CurrentPinInput, Mode=TwoWay}" RenderTransformOrigin="0,0">
                                                    <controls:PinInputControl.LayoutTransform>
                                                        <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                                                    </controls:PinInputControl.LayoutTransform>
                                                </controls:PinInputControl>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="{DynamicResource Secret_NewPin}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,4" />
                                                <controls:PinInputControl AutoSubmit="False" PinValue="{Binding NewPinInput, Mode=TwoWay}">
                                                    <controls:PinInputControl.LayoutTransform>
                                                        <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                                                    </controls:PinInputControl.LayoutTransform>
                                                </controls:PinInputControl>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Secret_ConfirmPin}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,4" />
                                                <controls:PinInputControl AutoSubmit="False" PinValue="{Binding ConfirmNewPinInput, Mode=TwoWay}">
                                                    <controls:PinInputControl.LayoutTransform>
                                                        <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                                                    </controls:PinInputControl.LayoutTransform>
                                                </controls:PinInputControl>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <TextBlock Text="{Binding ChangePinStatus}" Foreground="#FFD800" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,150,0" />
                                            <Button Content="{DynamicResource Secret_ChangePinBtn}" Command="{Binding ChangePinCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Email Alert Configuration (5 Failed PIN Attempts) -->
                                <TextBlock Text="{DynamicResource Mail_GroupTitle}" Foreground="#9AA4B8" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="10" Padding="16">
                                    <StackPanel>
                                        <!-- Status Pill -->
                                        <Border Background="#1B1F29" BorderBrush="#3A4254" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding MailStatusSummary}" Foreground="#E0E6F2" FontSize="12.5" TextWrapping="Wrap" />
                                        </Border>

                                        <!-- Alert Recipient Email (editable per user) -->
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Mail_RecipientLabel}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,4" />
                                            <TextBox Style="{StaticResource DarkTextBoxStyle}" Text="{Binding RecipientAddress, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="1.4*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Mail_SmtpHost}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,4" />
                                                <TextBox Style="{StaticResource DarkTextBoxStyle}" Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Mail_SmtpPort}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,4" />
                                                <TextBox Style="{StaticResource DarkTextBoxStyle}" Text="{Binding SmtpPortText, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="{DynamicResource Mail_TlsMode}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,4" />
                                                <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding AvailableTlsModes}" SelectedItem="{Binding TlsMode, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Mail_SenderAddress}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,4" />
                                                <TextBox Style="{StaticResource DarkTextBoxStyle}" Text="{Binding SenderAddress, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Mail_SenderName}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,4" />
                                                <TextBox Style="{StaticResource DarkTextBoxStyle}" Text="{Binding SenderDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Mail_AuthMethod}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,4" />
                                                <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding AvailableAuthMethods}" SelectedItem="{Binding AuthMethod, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Mail_Credential}" Foreground="#D4DCEB" FontSize="12" Margin="0,0,0,4" />
                                                <PasswordBox x:Name="MailCredentialBox" Style="{StaticResource DarkPasswordBoxStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{DynamicResource Mail_CredentialSavedHint}" Foreground="#8FD894" FontSize="11.5" Margin="0,0,0,8"
                                                   Visibility="{Binding HasStoredMailCredential, Converter={StaticResource BoolToVis}}" />

                                        <TextBlock Text="{Binding MailFeedbackMessage}" Foreground="#FFD800" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10"
                                                   Visibility="{Binding MailFeedbackMessage, Converter={StaticResource NotNullToVis}}" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="{DynamicResource Mail_SendTest}" Command="{Binding SendTestEmailCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                                            <Button Content="{DynamicResource Mail_SaveConfig}" Command="{Binding SaveMailConfigCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- =============================================== -->
                        <!-- PAGE 4: ABOUT (PersonalLauncher metadata ONLY)  -->
                        <!-- =============================================== -->
                        <StackPanel Visibility="{Binding IsAboutActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Settings_NavAbout}" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,22" />

                            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="12" Padding="22,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                                        <Border Width="62" Height="62" CornerRadius="31" ClipToBounds="True" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="2" Margin="0,0,16,0">
                                            <Image Source="{Binding PersonalLogoPreview}" Stretch="UniformToFill" controls:ClipHelper.IsCircular="True" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AppTitle}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{DynamicResource Settings_AboutVersion}" Foreground="#9AA4B8" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding AppVersionText}" Foreground="{StaticResource AccentGoldBrush}" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_AboutAuthor}" Foreground="#9AA4B8" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding AppAuthorText}" Foreground="#F5F7FA" FontSize="13.5" FontWeight="Medium" />
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_AboutDataDir}" Foreground="#9AA4B8" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DataDirectoryPath}" Foreground="#D4DCEB" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Grid.Column="2" Content="{DynamicResource Common_OpenFolder}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Command="{Binding OpenDataFolderCommand}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_AboutLibraries}" Foreground="#9AA4B8" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding LibrariesUsedText}" Foreground="#C4CCDC" FontSize="12.5" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
