<Window x:Class="PersonalLauncher.App.Views.EditLocationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource EditLoc_Title}"
        Width="600"
        Height="470"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1E222B"
        Icon="pack://application:,,,/PersonalLauncher;component/Assets/logo.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#3B4252" BorderThickness="1" Background="#1E222B">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#171A21" BorderBrush="#2E3440" BorderThickness="0,0,0,1" Padding="20,0,12,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource EditLoc_Title}" FontSize="15.5" FontWeight="SemiBold" Foreground="#F5F7FA" />
                        <TextBlock Text=" — " Foreground="#7B859A" FontSize="15.5" />
                        <TextBlock Text="{Binding GameName}" FontSize="15.5" Foreground="{StaticResource AccentGoldBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                    </StackPanel>
                    <Button Content="×" FontSize="20" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButtonStyle}" Click="Cancel_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
                <StackPanel>
                    <Border Background="#252A36" BorderBrush="#384052" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource EditLoc_Note}" Foreground="#C4CCDC" FontSize="12.5" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{DynamicResource AddGame_Exe}" Foreground="#D4DCEB" FontSize="12.5" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="{DynamicResource Common_Browse}" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseExe_Click" />
                    </Grid>

                    <TextBlock Text="{DynamicResource AddGame_InstallDir}" Foreground="#D4DCEB" FontSize="12.5" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="{DynamicResource Common_Browse}" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseDir_Click" />
                    </Grid>

                    <TextBlock Text="{DynamicResource AddGame_WorkingDir}" Foreground="#D4DCEB" FontSize="12.5" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="{DynamicResource Common_Browse}" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseWorkDir_Click" />
                    </Grid>

                    <TextBlock Text="{DynamicResource AddGame_Arguments}" Foreground="#D4DCEB" FontSize="12.5" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource DarkTextBoxStyle}" Text="{Binding ArgumentsMultiline, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="64" VerticalContentAlignment="Top" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A80" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#171A21" BorderBrush="#2E3440" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Button Content="{DynamicResource EditLoc_OpenCurrent}" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left" Command="{Binding OpenCurrentFolderCommand}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Common_Cancel}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="Cancel_Click" />
                        <Button Content="{DynamicResource Common_Save}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
