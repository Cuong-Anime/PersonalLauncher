<Window x:Class="PersonalLauncher.App.Views.ManagePinPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PersonalLauncher.App.Controls"
        Title="{DynamicResource Secret_UnlockTitle}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1E222B"
        Icon="pack://application:,,,/PersonalLauncher;component/Assets/logo.ico">

    <Border BorderBrush="#495061" BorderThickness="1" Background="#1E222B">
        <StackPanel>
            <Border Background="#171A21" BorderBrush="#2E3440" BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <TextBlock Text="{DynamicResource Secret_UnlockTitle}" FontSize="15.5" FontWeight="SemiBold" Foreground="#F5F7FA" VerticalAlignment="Center" />
                    <Button Content="×" FontSize="20" Width="32" Height="32" HorizontalAlignment="Right"
                            Style="{StaticResource TitleBarButtonStyle}" Click="Cancel_Click" />
                </Grid>
            </Border>

            <StackPanel Margin="26,22">
                <TextBlock Text="🔒" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="{DynamicResource Secret_UnlockManageDesc}"
                           Foreground="#C4CCDC" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />

                <controls:PinInputControl x:Name="PinControl"
                                          AutoSubmit="True"
                                          PinCompleted="PinControl_PinCompleted"
                                          InvalidInputAttempted="PinControl_InvalidInputAttempted" />

                <TextBlock x:Name="ErrorText" Foreground="#FF8A80" FontSize="12.5"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>

            <Border Background="#171A21" BorderBrush="#2E3440" BorderThickness="0,1,0,0" Padding="20,12">
                <Button Content="{DynamicResource Common_Cancel}" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right" Click="Cancel_Click" />
            </Border>
        </StackPanel>
    </Border>
</Window>
