<Window x:Class="PersonalLauncher.App.Views.EditLogoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PersonalLauncher.App.Controls"
        Title="{DynamicResource EditLogo_Title}"
        Width="560"
        Height="430"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1E222B"
        Icon="pack://application:,,,/PersonalLauncher;component/Assets/logo.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#3B4252" BorderThickness="1" Background="#1E222B">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#171A21" BorderBrush="#2E3440" BorderThickness="0,0,0,1" Padding="20,0,12,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource EditLogo_Title}" FontSize="15.5" FontWeight="SemiBold" Foreground="#F5F7FA" />
                        <TextBlock Text=" — " Foreground="#7B859A" FontSize="15.5" />
                        <TextBlock Text="{Binding GameName}" FontSize="15.5" Foreground="{StaticResource AccentGoldBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                    </StackPanel>
                    <Button Content="×" FontSize="20" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButtonStyle}" Click="Cancel_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,18">
                <!-- Sidebar Icon Section -->
                <TextBlock Text="{DynamicResource EditLogo_IconSection}" Foreground="#E2E7F2" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,10" />
                <Border Background="#171A22" BorderBrush="#2E3440" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="68" Height="68" CornerRadius="14" ClipToBounds="True" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="1.8" Background="#252A34">
                            <Image Source="{Binding IconPreview}" Stretch="UniformToFill" controls:ClipHelper.CornerRadius="12" />
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Common_Browse}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ChooseIcon_Click" />
                            <Button Content="{DynamicResource Common_ResetDefault}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetIconCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Title Logo Section -->
                <TextBlock Text="{DynamicResource EditLogo_TitleLogoSection}" Foreground="#E2E7F2" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,10" />
                <Border Background="#171A22" BorderBrush="#2E3440" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Height="68" Background="#242934" CornerRadius="8" Padding="10" Margin="0,0,14,0">
                            <Grid>
                                <Image Source="{Binding TitleLogoPreview}" Stretch="Uniform"
                                       Visibility="{Binding TitleLogoPreview, Converter={StaticResource NotNullToVis}}" />
                                <TextBlock Text="{Binding GameName}" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ShowTitleTextFallback, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="{DynamicResource Common_Browse}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="ChooseTitleLogo_Click" />
                            <Button Content="{DynamicResource EditLogo_UseTextFallback}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearTitleLogoCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A80" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>

            <Border Grid.Row="2" Background="#171A21" BorderBrush="#2E3440" BorderThickness="0,1,0,0" Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Common_Cancel}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button Content="{DynamicResource Common_Save}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
