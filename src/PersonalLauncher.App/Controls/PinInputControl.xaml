<UserControl x:Class="PersonalLauncher.App.Controls.PinInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Border x:Name="Box0" Width="52" Height="58" Margin="0,0,10,0" CornerRadius="10"
                Background="#1A1D25" BorderBrush="#495266" BorderThickness="1.6">
            <TextBlock x:Name="Dot0" Text="" FontSize="26" Foreground="#FFD800"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="Box1" Width="52" Height="58" Margin="0,0,10,0" CornerRadius="10"
                Background="#1A1D25" BorderBrush="#495266" BorderThickness="1.6">
            <TextBlock x:Name="Dot1" Text="" FontSize="26" Foreground="#FFD800"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="Box2" Width="52" Height="58" Margin="0,0,10,0" CornerRadius="10"
                Background="#1A1D25" BorderBrush="#495266" BorderThickness="1.6">
            <TextBlock x:Name="Dot2" Text="" FontSize="26" Foreground="#FFD800"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="Box3" Width="52" Height="58" CornerRadius="10"
                Background="#1A1D25" BorderBrush="#495266" BorderThickness="1.6">
            <TextBlock x:Name="Dot3" Text="" FontSize="26" Foreground="#FFD800"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </StackPanel>
</UserControl>
